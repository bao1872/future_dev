      "y": "feat_5m_1h_neg_semivar_share"
    },
    {
      "name": "momentum_1h_x_volaccel",
      "x": "feat_5m_1h_ret_sum",
      "y": "feat_5m_rv_rate_ratio_1h_4h"
    },
    {
      "name": "jump_1h_x_location_32",
      "x": "feat_5m_1h_jump_share",
      "y": "feat_15m_location_32"
    },
    {
      "name": "badvol_1h_x_rv_1h",
      "x": "feat_5m_1h_neg_semivar_share",
      "y": "feat_5m_1h_rv"
    },
    {
      "name": "oi_change_x_volume",
      "x": "feat_15m_oi_log_change_4",
      "y": "feat_15m_volume_ratio_32"
    }
  ],
  "uses_model": false,
  "uses_backtest": false,
  "uses_smc": false,
  "uses_momentum": false,
  "uses_oracle_as_feature": false,
  "statistical_inference_claim": false,

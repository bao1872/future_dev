    "F2_ACTIVITY": [
      "feat_15m_ret_1",
      "feat_15m_ret_4",
      "feat_15m_ret_8",
      "feat_15m_ret_16",
      "feat_15m_location_32",
      "feat_time_bars_since_segment_start",
      "feat_time_after_long_gap",
      "feat_15m_volume_ratio_32",
      "feat_15m_oi_log_change_4"
    ],
    "F3_VOL": [
      "feat_15m_ret_1",
      "feat_15m_ret_4",
      "feat_15m_ret_8",
      "feat_15m_ret_16",
      "feat_15m_location_32",
      "feat_time_bars_since_segment_start",
